# This file defines all environment variables that the application needs.
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=7f9b8c5d6e4a2b1f3d5c7e9a0b2d4f6a # Exemple de secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# On utilise l'hôte "database" qui correspond au nom du service dans docker-compose.yml
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=true
###< symfony/messenger ###

###> symfony/mailer ###
# MAILER_DSN=null://default
###< symfony/mailer ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8081
###< symfony/routing ###